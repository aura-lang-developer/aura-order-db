          currency: `${r.currency}`,
          subtotal: subFloat,
          taxAmount: taxFloat,
          discountAmount: discFloat,
          totalAmount: totalFloat,
          notes: if r.notes != null { `${r.notes}` } else { "" },
          createdBy: `${r.created_by}`,
          createdAt: `${r.created_at}`,
          updatedAt: `${r.updated_at}`,
          items: itemsList
        };
        orders = append(orders, po);
      }
      orders
    },
    Err(_) => {
      let empty: []PurchaseOrder = [];
      empty
    }
  }
};

// 5. Updates order status and audit metadata using Aura ORM UpdateBuilder
export async fn (repo: PostgresOrderRepository) Update(order: PurchaseOrder): Task<Result<Unit, String>, String> => {
  let qUpdate = repo.orm.UpdateTable("purchase_orders")
    .Set("status", order.status)
    .Set("notes", order.notes)
    .Set("updated_at", order.updatedAt)
    .Where("id", "=", order.id)
    .ToSql();

  let res = await repo.orderDb.execute(qUpdate.sql, qUpdate.params);

  match res {
    Ok(info) => {
      if info.rowCount > 0 {
        Ok(())
      } else {
        Err(`Order '${order.id}' not found for update`)
      }
    },
    Err(e) => Err(`Failed to update order in PostgreSQL: ${e}`)
  }
};
