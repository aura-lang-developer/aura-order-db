          .Select("unit_price")
          .Select("line_total")
          .Where("order_id", "=", ordId)
          .OrderBy("id", "ASC")
          .ToSql();

        let itemRes = await repo.orderDb.query(qItems.sql, qItems.params);
        let mut itemsList: []OrderItem = [];
        match itemRes {
          Ok(itemRows) => {
            for ir in itemRows {
              let qInt = parseInt(`${ir.quantity}`, 10);
              let uFloat = parseFloat(`${ir.unit_price}`);
              let lFloat = parseFloat(`${ir.line_total}`);
              let idInt = parseInt(`${ir.id}`, 10);

              let oi: OrderItem = {
                id: idInt,
                orderId: `${ir.order_id}`,
                productSku: `${ir.product_sku}`,
                productName: `${ir.product_name}`,
                quantity: qInt,
                unitPrice: uFloat,
                lineTotal: lFloat
              };
              itemsList = append(itemsList, oi);
            }
          },
          Err(_) => ()
        };

        let subFloat = parseFloat(`${r.subtotal}`);
        let taxFloat = parseFloat(`${r.tax_amount}`);
        let discFloat = parseFloat(`${r.discount_amount}`);
        let totalFloat = parseFloat(`${r.total_amount}`);

        let po: PurchaseOrder = {
          id: ordId,
          orderNumber: `${r.order_number}`,
          supplierId: `${r.supplier_id}`,
