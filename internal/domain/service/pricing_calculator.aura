// ==============================================================================
// Domain Layer: Pricing Calculator Domain Service
// internal/domain/service/pricing_calculator.aura - Pure Business Logic for Order Totals
// ==============================================================================

export struct OrderPricingResult {
  subtotal: Float,
  discountAmount: Float,
  taxAmount: Float,
  totalAmount: Float
};

export struct PricingCalculator {
  taxRate: Float,
  volumeDiscountThreshold: Float,
  volumeDiscountRate: Float
};

export fn NewPricingCalculator(
  taxRate: Float = 0.19,
  volumeDiscountThreshold: Float = 5000.0,
  volumeDiscountRate: Float = 0.05
): PricingCalculator => {
  {
    taxRate: taxRate,
    volumeDiscountThreshold: volumeDiscountThreshold,
    volumeDiscountRate: volumeDiscountRate
  }
}

// Computes the pricing breakdown for a subtotal
fn (calc: PricingCalculator) CalculateTotals(subtotal: Float): OrderPricingResult => {
  let discount = if subtotal >= calc.volumeDiscountThreshold {
    subtotal * calc.volumeDiscountRate
  } else {
    0.0
  };

  let taxableBase = subtotal - discount;
  let tax = taxableBase * calc.taxRate;
  let total = taxableBase + tax;

  {
    subtotal: subtotal,
    discountAmount: discount,
    taxAmount: tax,
    totalAmount: total
  }
}
