# Aura Purchase Orders Microservice - Environment Configuration
PORT=:8085
SERVICE_NAME="Aura Purchase Orders Microservice (Onion Architecture)"
ENVIRONMENT=development
LOG_LEVEL=debug

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=secret
DB_NAME=orders_db
DB_SSL=false
DB_MAX_CONNECTIONS=20

# Business Rules / Financials
TAX_RATE=0.19
VOLUME_DISCOUNT_THRESHOLD=5000.0
VOLUME_DISCOUNT_RATE=0.05
