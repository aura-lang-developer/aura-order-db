// ==============================================================================
// Aura ORM - Schema & Migrations Module
// src/schema/schema.aura - DDL Schema Definition & Table Migrations
// ==============================================================================

import { Dialect, QuoteIdentifier } from "../dialect/dialect";

export struct ColumnDef {
  __aura_type: String,
  name: String,
  dataType: String, // "INTEGER", "BIGINT", "VARCHAR", "TEXT", "BOOLEAN", "NUMERIC", "TIMESTAMP"
  length: Int,      // for VARCHAR length (e.g. 255)
  isPrimary: Bool,
  isNullable: Bool,
  isUnique: Bool,
  defaultValue: String,
  refTable: String,
  refColumn: String,
  onDeleteAction: String
};

export fn IntegerColumn(name: String): ColumnDef => {
  {
    __aura_type: "ColumnDef",
    name: name,
    dataType: "INTEGER",
    length: 0,
    isPrimary: false,
    isNullable: false,
    isUnique: false,
    defaultValue: "",
    refTable: "",
    refColumn: "",
    onDeleteAction: ""
  }
};

export fn BigIntColumn(name: String): ColumnDef => {
  {
    __aura_type: "ColumnDef",
    name: name,
    dataType: "BIGINT",
    length: 0,
    isPrimary: false,
    isNullable: false,
    isUnique: false,
    defaultValue: "",
    refTable: "",
    refColumn: "",
    onDeleteAction: ""
  }
};

export fn StringColumn(name: String, len: Int): ColumnDef => {
  {
    __aura_type: "ColumnDef",
    name: name,
    dataType: "VARCHAR",
    length: len,
    isPrimary: false,
    isNullable: false,
    isUnique: false,
    defaultValue: "",
    refTable: "",
    refColumn: "",
    onDeleteAction: ""
  }
};

